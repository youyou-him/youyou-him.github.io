---
const today = new Date();
---

<footer>
	<div class="inner">
		<span>&copy; {today.getFullYear()} youyou-him</span>
		<div class="links">
			<a href="https://github.com/youyou-him" target="_blank">GitHub</a>
			<a href="/rss.xml">RSS</a>
		</div>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.88em;
	}
	.inner {
		width: 680px;
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		padding: 1.6rem 0 2.2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.links {
		display: flex;
		gap: 1.2rem;
	}
	footer a {
		color: var(--text-muted);
	}
	footer a:hover {
		color: var(--text);
	}
</style>
