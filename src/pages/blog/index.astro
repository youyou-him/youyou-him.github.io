---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	if (!postsByYear.has(year)) postsByYear.set(year, []);
	postsByYear.get(year)!.push(post);
}
const years = [...postsByYear.keys()].sort((a, b) => b - a);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`글 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-title {
				padding: 3rem 0 1.5rem;
			}
			.page-title h1 {
				margin: 0;
			}
			.year-label {
				font-size: 0.74em;
				font-weight: 700;
				letter-spacing: 0.16em;
				color: var(--accent);
				margin: 2.4rem 0 0.4rem 0;
			}
			section:first-of-type .year-label {
				margin-top: 0;
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li {
				margin: 0;
			}
			li a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1.5rem;
				padding: 1.15rem 0;
				border-bottom: 1px solid var(--border);
				color: var(--text);
			}
			li a:hover {
				text-decoration: none;
			}
			li a:hover .post-title {
				color: var(--accent);
			}
			.post-title {
				font-family: var(--font-serif);
				font-weight: 600;
				font-size: 1.16em;
				line-height: 1.5;
				letter-spacing: -0.01em;
			}
			li time {
				flex-shrink: 0;
				font-size: 0.82em;
				color: var(--text-muted);
				font-variant-numeric: tabular-nums;
			}
			@media (max-width: 560px) {
				li a {
					flex-direction: column;
					gap: 0.15rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-title"><h1>글</h1></div>
			{
				years.map((year) => (
					<section>
						<p class="year-label">{year}</p>
						<ul>
							{postsByYear.get(year)!.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span class="post-title">{post.data.title}</span>
										<FormattedDate date={post.data.pubDate} />
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
